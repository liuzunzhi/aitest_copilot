# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# 环境变量
.env

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
reports/

# Playwright 前台用例产物（截图落仓库根 .screenshots/）
test-results/
.screenshots/

# 上传的文档原文（03-documents）
var/uploads/

# 自动化资产根目录（09-automation）——用户放自己的测试脚本的地方，
# 不该进版本库（e2e 也会往这里写样例文件）
var/automation/

# 脚本起的服务日志（scripts/run_e2e.py / start_dev.bat）
var/*.log

# var/ 下的其它运行时产物（临时脚本、日志重定向文件等）——
# 这个目录只放「跑起来才产生的东西」，版本库里一张都不该有。
# **不要**为 var/uploads/ 或 var/automation/ 写反向放行规则：
# 那两个目录装的是**用户的数据**（上传的文档原文、自己的测试脚本），
# 放进版本库等于把用户数据泄露出去。
var/*

# 编辑器
.idea/
.vscode/
*.swp

# 系统
Thumbs.db
.DS_Store

# 联调用的真实需求文档（06 期 T87 的 L1/L2 联调样本，不进版本库）
测试用的需求文档_不提交git/

# 内部资料（含管理员账号等凭据，不进版本库）
doc/

# IDE 的私有规则目录
.trae/

# 账号清单（含各环境的账号密码，不进版本库）
账号.md