# 复制为 .env 后按实际情况填写。.env 不纳入版本管理。

# MySQL 连接串（必填）
DB_DSN=mysql+pymysql://aitest:aitestpass123@127.0.0.1:3306/aitest_copilot_v2?charset=utf8mb4

# Redis 连接串（容器 aitest-redis，映射到 6380）
REDIS_URL=redis://127.0.0.1:6380/0

# bcrypt 计算成本，取值 4 ~ 16
BCRYPT_COST=12

# 大模型配置的主密钥（必填，06 期 T84 起）。
# 用于加密 llm_providers 表里的 API Key——主密钥本身不进数据库。
# 由 sha256 派生出 Fernet 密钥，所以任意长度的字符串都能用，不必手工生成 32 字节。
# 生成方式：python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 注意：换掉这把密钥 = 库里已存的密文全部解不开，大模型配置需要重新录入。
# 供应商的 API Key 本身不走这里——它由管理员在「系统设置」页录入，密文落库。
LLM_SECRET_KEY=
